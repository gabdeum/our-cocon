{
  "permissions": {
    "allow": [
      "Bash(pnpm check*)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:all)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm theme)",
      "Bash(pnpm db:types)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./supabase/.temp/**)",
      "Bash(cat *.env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(supabase link*)",
      "Bash(supabase db push*)",
      "Bash(supabase db reset --linked*)",
      "Bash(pnpm supabase db push*)",
      "Bash(npx supabase db push*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-file.sh\"" }
        ]
      }
    ]
  }
}
