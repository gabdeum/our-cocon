{
  "expo": {
    "name": "Our Cocon",
    "slug": "our-cocon",
    "scheme": "ourcocon",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ourcocon.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
