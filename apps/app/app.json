{
  "expo": {
    "name": "Our Cocon",
    "slug": "our-cocon",
    "scheme": "ourcocon",
    "version": "0.8.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/d1d31ef9-da74-4f0a-9630-6f1d92fa3e27"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.ourcocon.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:app.ourcocon.com"
      ],
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "appleTeamId": "59TR87TBX2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#FEF6E3"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FEF6E3"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Our Cocon uses your photos so you can add one to a recipe.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-asset",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/kitchen-bell.caf"]
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1056584882565-1kosa2us2rv00lqvn9mbif6uf6se267d"
        }
      ],
      "@bacons/apple-targets",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d1d31ef9-da74-4f0a-9630-6f1d92fa3e27"
      }
    },
    "owner": "gabdeum"
  }
}
