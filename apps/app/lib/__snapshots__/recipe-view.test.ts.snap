exports[`steps (spec 009) > spec 017 SC-001: every variant combination of the seed quiche, step by step 1`] = `
{
  "choice": {
    "options": [],
    "version": null,
  },
  "steps": [
    "1 Preheat and line: Preheat the oven to 180 °C (350 °F). Line a 23 cm (9 in) tart pan with 1 sheet of shortcrust pastry (230 g) and prick the base with a fork.",
    "2 Blind bake: Bake the empty crust for 12 minutes until pale golden.",
    "3 Cook the filling: In a large pan, melt 20 g butter over medium heat. Add 2 leeks (300 g) finely sliced and cook 6–8 minutes until soft. Add 200 g bacon lardons and cook 5 minutes until golden.",
    "4 Mix the custard: Whisk 3 large eggs (150 g) with 300 ml heavy cream and 1 pinch of nutmeg. Season with salt and pepper, then stir in half of the 100 g gruyère, grated.",
    "5 Bake: Spread the filling in the crust, pour over the custard and top with the rest of the cheese. Bake for 35 minutes.",
    "6 Rest: Let it rest for 10 minutes before slicing, so it holds together.",
  ],
}
`;

