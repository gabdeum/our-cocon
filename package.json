{
  "name": "our-cocon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "test": "vitest run --reporter=./scripts/vitest-quiet-reporter.ts",
    "test:all": "vitest run --reporter=./scripts/vitest-quiet-reporter.ts",
    "lint": "eslint --quiet .",
    "typecheck": "pnpm -r --silent typecheck && tsc --noEmit --pretty false -p scripts && tsc --noEmit --pretty false -p infra",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --local > packages/schemas/database.types.ts",
    "theme": "node scripts/theme.mjs",
    "catalog": "tsx scripts/catalog.ts",
    "purge": "tsx scripts/purge-deleted.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "dotenv-cli": "^11.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "pg": "^8.23.1",
    "supabase": "2.120.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
