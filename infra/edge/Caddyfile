# The server's front door. Cloudflare connects here over HTTPS (Full strict) with the Cloudflare
# origin certificate; Caddy passes each hostname to the right container on that environment's cocon-edge-<env> network.
# COCON_DOMAIN and CLOUDFLARE_IPS come from compose.yml (CLOUDFLARE_IPS is written by provision.sh).
{
	admin off
	auto_https disable_certs
	servers {
		trusted_proxies static {$CLOUDFLARE_IPS}
		client_ip_headers CF-Connecting-IP
	}
}

(site) {
	# Only Cloudflare may connect (the Hetzner firewall does the same one level earlier).
	@outside not remote_ip {$CLOUDFLARE_IPS}
	abort @outside

	tls /certs/origin.pem /certs/origin.key
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), microphone=(), payment=()"
		-Server
	}
}

# Supabase's public API only. Studio, /pg/ (database admin) and Supabase's own /mcp stay private.
# Of the Edge Functions, only the share endpoints are public (specs 019 and 042), plus the two that
# check a member's token themselves (spec 045: apple-sign-in, delete-account). An assistant's token
# is refused by both (role cocon_assistant), so they need no assistant check here.
# (Plain respond/reverse_proxy, not handle blocks: Caddy runs handle before the abort above.)
# Spec 023: AI assistants sign in through Supabase's OAuth server. They send no apikey, which the
# gateway wants on /auth/v1/*, so the OAuth and discovery routes get this environment's anon key
# (args[1], public anyway). Assistants look the server up at the standard address for an issuer
# with a path (RFC 8414: /.well-known/oauth-authorization-server/auth/v1); Supabase answers it
# without the suffix.
(api) {
	@private not path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/* /graphql/v1 /graphql/v1/* /.well-known/oauth-authorization-server* /functions/v1/shared-recipe /functions/v1/shared-event /functions/v1/apple-sign-in /functions/v1/delete-account
	respond @private 404
	@oauth path /auth/v1/oauth/* /auth/v1/.well-known/*
	request_header @oauth apikey {args[1]}
	rewrite /.well-known/oauth-authorization-server/auth/v1 /.well-known/oauth-authorization-server
	# Spec 025 (032-later L62): Supabase Auth ignores a token's role, so an assistant's token could
	# sign the member out everywhere, approve or revoke assistants (undoing a Disconnect) or change
	# the account. The MCP server's internal check answers 403 for an assistant's token.
	# Everything under /user/ (grants, identities, a trailing slash), sign-out, approvals, MFA and
	# reauthentication; on /user itself, anything but the GET the MCP server makes.
	@member_only path /auth/v1/logout* /auth/v1/oauth/authorizations* /auth/v1/user/* /auth/v1/factors* /auth/v1/reauthenticate*
	@account_change {
		not method GET HEAD OPTIONS
		path /auth/v1/user
	}
	forward_auth @member_only {args[0]}-mcp:8788 {
		uri /assistant-check
	}
	forward_auth @account_change {args[0]}-mcp:8788 {
		uri /assistant-check
	}
	reverse_proxy {args[0]}-api:8000
}

app.{$COCON_DOMAIN} {
	import site
	reverse_proxy prod-web:8080
}

mcp.{$COCON_DOMAIN} {
	import site
	# The MCP server limits requests per address: give it the real one (Cloudflare's CF-Connecting-IP,
	# see client_ip_headers), never what the caller wrote in X-Forwarded-For.
	reverse_proxy prod-mcp:8787 {
		header_up X-Forwarded-For {client_ip}
	}
}

api.{$COCON_DOMAIN} {
	import site
	import api prod {$PROD_ANON_KEY}
}

# Behind Cloudflare Access (email PIN), then Supabase's dashboard password.
studio.{$COCON_DOMAIN} {
	import site
	reverse_proxy prod-api:8000
}

app-staging.{$COCON_DOMAIN} {
	import site
	reverse_proxy staging-web:8080
}

mcp-staging.{$COCON_DOMAIN} {
	import site
	# The MCP server limits requests per address: give it the real one (Cloudflare's CF-Connecting-IP,
	# see client_ip_headers), never what the caller wrote in X-Forwarded-For.
	reverse_proxy staging-mcp:8787 {
		header_up X-Forwarded-For {client_ip}
	}
}

api-staging.{$COCON_DOMAIN} {
	import site
	import api staging {$STAGING_ANON_KEY}
}

studio-staging.{$COCON_DOMAIN} {
	import site
	reverse_proxy staging-api:8000
}
