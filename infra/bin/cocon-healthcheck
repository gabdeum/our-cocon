#!/usr/bin/env bash
# Server alerts by email (to ALERT_EMAIL, through the Resend API). Run every 5 minutes by
# cocon-healthcheck.timer, and by cocon-alert@.service when a backup or other unit fails.
#
#   cocon-healthcheck                   Check disk, memory, swap and container health
#   cocon-healthcheck alert <unit>      Email that a systemd unit failed, with its last log lines
#
# The same problem is emailed again at most every 6 hours while it lasts.
[ -z "${SUDO_USER:-}" ] || unset COCON_HOME
. "${COCON_HOME:-/opt/cocon/infra}/lib/common.sh"

host=$(hostname)
repeat_after=$((6 * 3600))

send() {
  local subject=$1 body=$2 key rc=0
  key=$(mktemp "$COCON_RUN/resend.XXXXXX")
  cocon-secrets open resend-api-key "$key"
  jq -n --arg from "$MAIL_FROM_NAME <$MAIL_FROM_ADDRESS>" --arg to "$ALERT_EMAIL" \
    --arg subject "[$host] $subject" --arg text "$body" \
    '{from: $from, to: [$to], subject: $subject, text: $text}' |
    curl -sS --fail --max-time 20 https://api.resend.com/emails -H @<(printf 'Authorization: Bearer %s\n' "$(cat "$key")") \
      -H 'Content-Type: application/json' --data @- >/dev/null || rc=$?
  rm -f "$key"
  return $rc
}

# problem <id> <subject> <details>: email unless the same problem was emailed recently.
problem() {
  local stamp="$COCON_STATE/alerts/$1" now
  now=$(date +%s)
  if [ -f "$stamp" ] && [ $((now - $(cat "$stamp"))) -lt $repeat_after ]; then return; fi
  send "$2" "$3

Server: $host
What to do: docs/operations.md, section Alerts."
  echo "$now" >"$stamp"
}

ok() { rm -f "$COCON_STATE/alerts/$1"; }

mkdir -p "$COCON_STATE/alerts" "$COCON_RUN"

if [ "${1:-}" = alert ]; then
  unit=${2:?unit is required}
  send "$unit failed" "$unit failed on $host. Its last log lines:

$(journalctl -u "$unit" -n 30 --no-pager 2>&1)

What to do: docs/operations.md, section Alerts."
  exit 0
fi

disk=$(df --output=pcent / | tail -n 1 | tr -dc 0-9)
if [ "$disk" -gt 80 ]; then
  problem disk "Disk ${disk}% full" "The server's disk is ${disk}% full (alert above 80%)."
else ok disk; fi

read -r mem_total mem_available swap_total swap_free < <(awk '
  /^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} /^SwapTotal:/ {st=$2} /^SwapFree:/ {sf=$2}
  END {print t, a, st, sf}' /proc/meminfo)
mem_used=$(((mem_total - mem_available) * 100 / mem_total))
if [ "$mem_used" -gt 90 ]; then
  problem memory "Memory ${mem_used}% used" "Memory use is ${mem_used}% (alert above 90%)."
else ok memory; fi

if [ "$swap_total" -gt 0 ]; then
  swap_used=$(((swap_total - swap_free) * 100 / swap_total))
  if [ "$swap_used" -gt 50 ]; then
    problem swap "Swap ${swap_used}% used" "The server is short of memory: swap is ${swap_used}% used (alert above 50%)."
  else ok swap; fi
fi

unhealthy=$(docker ps --filter health=unhealthy --format '{{.Names}}' | tr '\n' ' ')
if [ -n "$unhealthy" ]; then
  problem containers "Unhealthy: $unhealthy" "These containers fail their health check: $unhealthy"
else ok containers; fi
