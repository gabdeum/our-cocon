#!/usr/bin/env bash
# Installs one commit on one environment. CI runs it over SSH as `deploy` (through sudo):
#
#   cocon-deploy <staging|prod> <40-character commit>
#
# 1. Pull the web, mcp and migrate images for the commit.  Fails → nothing changed.
#    The commit needs newer server scripts (infra/VERSION) → nothing changed.
# 2. Apply pending database migrations (all or none).     Fails → nothing changed.
# 3. Install the commit's Edge Functions and reload them.
# 4. Start the new web and MCP containers.
# 5. Wait until both report the new commit. If they don't within COCON_HEALTH_TIMEOUT seconds,
#    start the previous commit again and fail.
[ -z "${SUDO_USER:-}" ] || unset COCON_HOME
. "${COCON_HOME:-/opt/cocon/infra}/lib/common.sh"

env=${1:-}
sha=${2:-}
check_env "$env"
check_sha "$sha"
[ $# -eq 2 ] || die "usage: cocon-deploy <env> <commit>"

timeout=${COCON_HEALTH_TIMEOUT:-60}
state="$COCON_SRV/$env"
prefix=$COCON_IMAGE_PREFIX

trap release_env EXIT
use_env "$env"
mkdir -p "$state"
previous=$(cat "$state/current" 2>/dev/null || true)

log "deploying ${sha:0:7} to $env"

for image in web mcp migrate; do
  docker pull -q "$prefix-$image:$sha" >/dev/null || die "could not pull $image:$sha; $env is unchanged"
done

# Server scripts (infra/VERSION): only bootstrap-from-laptop.sh installs them, so a commit that
# needs newer ones than the server has stops here. Images from before the check need version 0.
staged=$(mktemp -d)
cid=$(docker create "$prefix-migrate:$sha") || die "could not read the migrate image of ${sha:0:7}; $env is unchanged"
docker cp "$cid:/app/infra-version" "$staged/infra-version" >/dev/null 2>&1 || true
docker rm "$cid" >/dev/null || true
needs= has=
[ ! -f "$staged/infra-version" ] || needs=$(env_value "$staged/infra-version" version)
[ ! -f "$COCON_HOME/VERSION" ] || has=$(env_value "$COCON_HOME/VERSION" version)
rm -rf "$staged"
needs=${needs:-0} has=${has:-0}
[[ $needs =~ ^[0-9]+$ && $has =~ ^[0-9]+$ ]] || die "unreadable infra version (commit: $needs, server: $has); $env is unchanged"
if [ "$needs" -gt "$has" ]; then
  die "${sha:0:7} needs server scripts v$needs, the server has v$has. From main on your laptop, run infra/bootstrap-from-laptop.sh <server-ip>, then deploy again. $env is unchanged"
fi

password=$(env_value "$COCON_RUN/$env/supabase.env" POSTGRES_PASSWORD)
[ -n "$password" ] || die "POSTGRES_PASSWORD is missing from $env's Supabase settings"
printf 'DATABASE_URL=postgres://postgres:%s@db:5432/postgres\n' "$password" >"$COCON_RUN/$env/migrate.env"

stack_container "$env" db >/dev/null
docker run --rm --network "cocon-${env}_default" --env-file "$COCON_RUN/$env/migrate.env" \
  "$prefix-migrate:$sha" || die "migrations failed and were rolled back; $env is unchanged"

# Edge Functions (spec 019): the commit's supabase/functions, carried by the migrate image, go next
# to Supabase's own `main` router (left as is); then the functions container reloads them. They
# stay on a rollback: each function keeps answering older app versions.
functions="$(supabase_dir "$env")/volumes/functions"
staged=$(mktemp -d)
cid=$(docker create "$prefix-migrate:$sha") || die "could not read the functions of ${sha:0:7}"
docker cp "$cid:/app/functions/." "$staged" >/dev/null || die "could not copy the functions of ${sha:0:7}"
docker rm "$cid" >/dev/null || true
mkdir -p "$functions"
for fn in "$staged"/*/; do
  name=$(basename "$fn")
  [ "$name" = main ] && continue
  rm -rf "${functions:?}/$name"
  cp -R "${fn%/}" "$functions/$name"
done
rm -rf "$staged"
docker restart "$(stack_container "$env" functions)" >/dev/null || die "could not restart Supabase functions on $env"

app() {
  COCON_ENV=$env COCON_SHA=$1 COCON_RUN=$COCON_RUN COCON_IMAGE_PREFIX=$prefix \
    docker compose -p "cocon-$env-app" -f "$COCON_HOME/app/compose.yml" up -d --quiet-pull --remove-orphans
}

# serves <commit>: both containers report it.
serves() {
  docker exec "$env-web" wget -qO- http://127.0.0.1:8080/version.json 2>/dev/null | grep -q "\"$1\"" &&
    docker exec "$env-mcp" node -e "fetch('http://127.0.0.1:8787/health').then(r=>r.text()).then(t=>console.log(t))" \
      2>/dev/null | grep -q "\"$1\""
}

app "$sha" || true
deadline=$((SECONDS + timeout))
until serves "$sha"; do
  if [ $SECONDS -ge $deadline ]; then
    if [ -n "$previous" ]; then
      log "${sha:0:7} did not come up in ${timeout}s; going back to ${previous:0:7}"
      app "$previous" || log "could not restart ${previous:0:7}; check: docker ps -a"
    else
      log "${sha:0:7} did not come up in ${timeout}s; stopping it (no earlier version to go back to)"
      docker compose -p "cocon-$env-app" -f "$COCON_HOME/app/compose.yml" down || true
    fi
    die "deploy of ${sha:0:7} to $env failed"
  fi
  sleep 2
done

[ -n "$previous" ] && [ "$previous" != "$sha" ] && echo "$previous" >"$state/previous"
echo "$sha" >"$state/current"

# Images not used by any container for a week (old releases) go, to keep the disk free.
docker image prune -af --filter "until=168h" >/dev/null 2>&1 || true

log "${sha:0:7} is live on $env"
