#!/usr/bin/env bash
# Sealed secrets for Our Cocon. Each secret is a file encrypted with systemd-creds under
# /etc/cocon/creds, readable by root only. Plain copies live in /run (memory, wiped at reboot)
# only while a command needs them.
#
#   cocon-secrets unlock <env>          Decrypt <env>'s Supabase and app settings into /run/cocon/<env>/
#   cocon-secrets lock <env>            Remove them again
#   cocon-secrets get <env> <KEY>       Print one Supabase setting, e.g. DASHBOARD_PASSWORD (Studio login)
#   cocon-secrets ask <name> <question> Ask at a hidden prompt and seal the answer as <name>
#   cocon-secrets seal <name> <file>    Seal a file as <name> and delete the plain file
#   cocon-secrets open <name> <dest>    Decrypt one secret to <dest>
#   cocon-secrets edit <name>           Change a sealed file in $EDITOR (nano by default), then reseal it
#   cocon-secrets has <name>            Exit 0 if <name> is sealed
[ -z "${SUDO_USER:-}" ] || unset COCON_HOME
. "${COCON_HOME:-/opt/cocon/infra}/lib/common.sh"

cred() { echo "$COCON_CREDS/$1.cred"; }

scratch() {
  mkdir -p "$COCON_RUN"
  mktemp "$COCON_RUN/$1.XXXXXX"
}

seal() {
  mkdir -p "$COCON_CREDS"
  systemd-creds encrypt --name="$1" --with-key=host "$2" "$(cred "$1").new"
  mv "$(cred "$1").new" "$(cred "$1")"
}

open() {
  [ -f "$(cred "$1")" ] || die "secret $1 is not set; run provision.sh"
  mkdir -p "$(dirname "$2")"
  systemd-creds decrypt --name="$1" "$(cred "$1")" "$2"
}

unlock() {
  check_env "$1"
  open "$1-supabase.env" "$COCON_RUN/$1/supabase.env"
  open "$1-app.env" "$COCON_RUN/$1/app.env"
}

lock() {
  check_env "$1"
  rm -f "$COCON_RUN/$1/supabase.env" "$COCON_RUN/$1/app.env" "$COCON_RUN/$1/migrate.env"
}

cmd=${1:-}
shift || true
case "$cmd" in
  unlock) unlock "${1:-}" ;;
  lock) lock "${1:-}" ;;
  get)
    check_env "${1:-}"
    tmp=$(scratch get)
    trap 'rm -f "$tmp"' EXIT
    open "$1-supabase.env" "$tmp"
    value=$(env_value "$tmp" "${2:?KEY is required}")
    [ -n "$value" ] || die "$2 is not set"
    echo "$value"
    ;;
  ask)
    name=${1:?name is required}
    read -r -s -p "${2:-$name}: " value </dev/tty
    echo >&2
    [ -n "$value" ] || die "nothing entered"
    tmp=$(scratch ask)
    printf '%s' "$value" >"$tmp"
    seal "$name" "$tmp"
    rm -f "$tmp"
    ;;
  seal)
    seal "${1:?name is required}" "${2:?file is required}"
    rm -f "$2"
    ;;
  open) open "${1:?name is required}" "${2:?destination is required}" ;;
  edit)
    name=${1:?name is required}
    tmp=$(scratch edit)
    trap 'rm -f "$tmp"' EXIT
    open "$name" "$tmp"
    "${EDITOR:-nano}" "$tmp"
    seal "$name" "$tmp"
    log "$name sealed again. Apply it with: cocon-stack <env> up -d (Supabase) or a deploy (app)"
    ;;
  has) [ -f "$(cred "${1:?name is required}")" ] ;;
  *) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
