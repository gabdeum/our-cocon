# Non-secret server settings, read by provision.sh, the cocon-* commands and CI. Shell syntax.
# Secrets never go here: provision.sh asks for them and seals them on the server.

COCON_DOMAIN=ourcocon.com
COCON_IMAGE_PREFIX=ghcr.io/gabdeum/our-cocon

# Supabase self-hosted release (github.com/supabase/supabase, docker/ folder).
# Change it only through `cocon-supabase-update` (docs/operations.md).
SUPABASE_REF=self-hosted/v0.8.2

# Your own login on the server once root login is off (sudo with a password).
ADMIN_USER=gabriel

# Sign-in emails go through Resend SMTP; alerts use the Resend API with the same key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
MAIL_FROM_ADDRESS=no-reply@ourcocon.com
MAIL_FROM_NAME="Our Cocon"
ALERT_EMAIL=hello@ourcocon.com

# PostHog region (EU). Use https://us.i.posthog.com if the projects were created in the US.
POSTHOG_HOST=https://eu.i.posthog.com

# Backups on Cloudflare R2.
R2_BUCKET=cocon-backups
BACKUP_KEEP_DAYS=30

SWAP_SIZE=4G
