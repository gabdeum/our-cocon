# Every variable Our Cocon reads. Real values go in .env.local (git-ignored); `pnpm dev` creates
# it on first run with the local Supabase values filled in. Staging and prod never use this file:
# their settings are sealed on the server by infra/provision.sh.

# Web and iOS app (Expo inlines EXPO_PUBLIC_* at build time; the server's web build reads
# window.__COCON__ from /config.js instead).
EXPO_PUBLIC_ENV=local
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: leave empty locally to send no analytics.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
# Optional, defaults to "dev": EXPO_PUBLIC_COMMIT=

# Local Supabase Auth: Sign in with Google (spec 003). Optional; without them only the email link
# works locally. See docs/operations.md for how to get them.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# MCP server (spec 023). Locally the anon key and both addresses default to the app's
# (EXPO_PUBLIC_SUPABASE_ANON_KEY, http://localhost:8081, http://localhost:8787).
COCON_ENV=local
MCP_PORT=8787
SUPABASE_URL=
SUPABASE_ANON_KEY=
APP_URL=
MCP_URL=
POSTHOG_KEY=
POSTHOG_HOST=
# Optional, defaults to "dev"; the server's images have it built in: COCON_COMMIT=

# Server only, shown for completeness (set from the sealed settings, not from this file):
#   web container (infra/web/write-config.sh): COCON_ENV, SUPABASE_URL, SUPABASE_ANON_KEY, POSTHOG_KEY, POSTHOG_HOST
#   MCP container: the same app settings, plus APP_URL and MCP_URL (infra/provision.sh)
#   migrations (scripts/migrate.ts, run by cocon-deploy): DATABASE_URL
# Tests only, defaults to local Supabase: TEST_DATABASE_URL
